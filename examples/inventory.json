{
  "schema_version": 1,
  "defaults": {
    "max_age_seconds": 300,
    "min_events": 10,
    "max_clock_skew_seconds": 30,
    "require_signature": true
  },
  "assets": [
    {
      "id": "gateway-prod",
      "criticality": "high",
      "signals": {
        "logs": {
          "receiver": "otlp",
          "exporters": ["otlphttp/siem"],
          "required_processors": ["memory_limiter", "batch"],
          "forbidden_processors": ["filter/drop_secrets"]
        }
      }
    },
    {
      "id": "infra-01",
      "criticality": "medium",
      "signals": {
        "metrics": {
          "receiver": "hostmetrics",
          "exporters": ["otlphttp/metrics"],
          "min_events": 5
        }
      }
    }
  ]
}
